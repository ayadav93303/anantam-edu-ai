# Put these ONLY on your backend host as environment variables.
# You can configure one provider or both.

OPENAI_API_KEY=YOUR_OPENAI_SERVER_KEY
OPENAI_MODEL=gpt-5.6

GEMINI_API_KEY=YOUR_GEMINI_SERVER_KEY
GEMINI_MODEL=gemini-3.6-flash

# auto = OpenAI first, then Gemini fallback
# or: openai / gemini
AI_PROVIDER=auto

PORT=3000
